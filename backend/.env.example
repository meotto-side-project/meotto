# Database
RELATION_DATABASE_HOST=localhost
RELATION_DATABASE_USERNAME=meotto
RELATION_DATABASE_PASSWORD=qwer1234!@
RELATION_DATABASE_PORT=3306
RELATION_DATABASE_DATABASE=meotto

# JWT
JWT_SECRET=your-jwt-secret-key-must-be-at-least-32-characters-long

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cookie
COOKIE_SECURE=true
COOKIE_SAME_SITE=None
COOKIE_DOMAIN=
COOKIE_PATH=/

# Notification
NOTIFICATION_ENABLED=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# Firebase FCM
FCM_ENABLED=false
FCM_CREDENTIALS_PATH=

# AWS S3
AWS_S3_BUCKET=your-s3-bucket
AWS_REGION=ap-northeast-2

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Naver OAuth
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Kakao OAuth
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# OAuth
OAUTH_REDIRECT_URI=/
OAUTH_CALLBACK_BASE_URL=api.dev.meotto.io.kr # 로컬 테스트의 경우 localhost:8080
OAUTH_SUCCESS_REDIRECT_URL=dev.meotto.io.kr

# Application
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Docker
DOCKER_IMAGE=your-dockerhub-id/meotto-api:latest
