#!/usr/bin/env bash
# 커밋 전 Java 코드 포맷(Spotless) 자동 검사
# 건너뛰려면: git commit --no-verify (가급적 지양)

set -euo pipefail

if git diff --cached --name-only --diff-filter=ACM | grep -q '\.java$'; then
  echo "[MEOTTO] Spotless 포맷 검사 중... (./gradlew spotlessCheck)"
  if ! ./gradlew spotlessCheck -q; then
    echo "❌ 포맷 위반 발견 — ./gradlew spotlessApply 실행 후 다시 커밋하세요." >&2
    exit 1
  fi
fi
